      },
      "depends_on": []
    },
    {
      "seq": 42,
      "op": "create",
      "entity": "relationships",
      "local_id": "REL004",
      "dda_id": null,
      "fields": {
        "relationship_code": "LegalEntityFundParallels",
        "relationship_description": "Two funds or vehicles invest side by side, for example a main fund and its parallel fund, an alternative investment vehicle or a co-investment vehicle, for as long as they do. The kind of vehicle belongs to the link. It is not an investor's commitment to a fund.",
